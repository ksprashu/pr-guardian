{
  "modelProvider": "gemini",
  "allowNonWorkspaceAccess": false,
  "enableTerminalSandbox": true,
  "permissions": {
    "allow": [
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(grep)",
      "command(diff)"
    ],
    "deny": [
      "command(curl)",
      "command(wget)",
      "command(nc)",
      "command(ssh)",
      "command(env)",
      "command(printenv)",
      "command(python)",
      "command(python3)",
      "command(node)",
      "command(bash)",
      "command(sh)",
      "command(git)",
      "command(find)",
      "command(rg)",
      "command(tree)",
      "command(cat /proc)",
      "command(head /proc)",
      "command(tail /proc)",
      "command(grep /proc)",
      "command(diff /proc)",
      "command(regex:(curl|wget|nc|ssh|env|printenv|python3?|node|bash|sh|git|find|rg|tree)(\\s+.*)?)",
      "command(regex:.*(/proc(/|\\s|$)|\\benviron\\b).*)",
      "command(regex:[\\s\\S]*([;&|<>\\x60\\r\\n]|\\$\\(|\\$\\{|\\$[A-Za-z_])[\\s\\S]*)"
    ]
  }
}
